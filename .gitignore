data/maps/*.pbf
data/maps/*.osm.pbf
data/output/*.duckdb
data/output/*.db
data/db/*.duckdb
data/db/*.db
data/db/*.wal
data/db/*.tmp/
# downloaded DEM/DSM rasters — hundreds of MB each
data/dem/
logs/

