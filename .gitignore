# Generated data — not tracked
data/maps/*.pbf
data/maps/*.osm.pbf
data/output/*.duckdb
data/output/*.db
data/db/*.duckdb
data/db/*.db
data/db/*.wal
data/db/*.tmp/
data/db/*.levels/
# downloaded DEM/DSM rasters — hundreds of MB each
data/dem/
logs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/
# docs/notebooks: the pages that nbconvert makes before the docs build, and the files that a run writes
docs/notebooks/0*.md
docs/notebooks/*_files/
docs/notebooks/data/
docs/notebooks/out/
docs/notebooks/*.yaml

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
reports/
pbf/
screenshots/

# mkdocs build output
site/

# Area configs are local (they point at local PBFs / boundaries); only the template and the sample
# are published. `duckosm init-config` writes the template for pip users.
config/*.yaml
!config/template.yaml
!config/sample_monaco.yaml
/*.duckdb

# Rust engine (rust/): the build folder and the shared build folder of tools/cargo
rust/target
.shared-target/
src/duckosm/_rust*.so
src/duckosm/_rust*.pyd
